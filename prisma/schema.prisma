// SmartFarm AI Prisma Database Schema
// Supported DB: SQLite (Dev) / PostgreSQL (Prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// USER & AUTHENTICATION
// -------------------------------------------------------------

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String?    @unique
  phone              String?    @unique
  passwordHash       String?
  preferredLanguage  String     @default("en")
  state              String?
  district           String?
  village            String?
  pincode            String?
  lat                Float?
  lng                Float?
  timezone           String     @default("Asia/Kolkata")
  isDemo             Boolean    @default(false)
  experienceMode     String     @default("simple") // simple | expert
  onboardingStatus   String     @default("{}") // JSON string of step completion
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  roles              UserRole[]
  authTokens         AuthToken[]
  farms              Farm[]
  tasks              Task[]
  observations       FarmObservation[]
  irrigationRecords  IrrigationRecord[]
  diagnoses          CropDiagnosisRecord[]
  diagnosisFeedbacks DiagnosisFeedback[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  scheduledReminders ScheduledReminder[]
  emailDeliveryLogs  EmailDeliveryLog[]
  files              File[]
  cartItems          CartItem[]
  orders             Order[]
  assistantConversations AssistantConversation[]

  @@index([state, district])
}

model AuthToken {
  id           String    @id @default(uuid())
  userId       String
  type         String    // email_verification | password_reset | email_migration
  tokenHash    String    @unique
  otpCodeHash  String?
  pendingEmail String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // FARMER, ADMIN, EXPERT, BUYER
  label       String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique // e.g. farm.manage, admin.content
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// -------------------------------------------------------------
// FARM & FIELD MANAGEMENT
// -------------------------------------------------------------

model Farm {
  id             String    @id @default(uuid())
  userId         String
  name           String
  village        String?
  district       String?
  state          String?
  country        String    @default("IN")
  lat            Float?
  lng            Float?
  totalAreaHa    Float?
  areaInputValue Float?
  areaInputUnit  String?   @default("acre") // acre | hectare | bigha | guntha
  farmType       String?   @default("irrigated") // irrigated | rainfed | mixed | orchard | greenhouse | other
  waterSources   String?   @default("[]") // JSON string array
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields         Field[]
  tasks          Task[]
  weatherRecords WeatherRecord[]
  devices        IotDevice[]

  @@index([userId])
}

model Field {
  id               String    @id @default(uuid())
  farmId           String
  name             String
  areaHa           Float?
  areaInputValue   Float?
  areaInputUnit    String?   @default("acre")
  areaSource       String    @default("manual") // manual | computed
  boundaryGeoJson  String?   // JSON string of polygon geometry
  centroidLat      Float?
  centroidLng      Float?
  irrigationType   String?   @default("drip") // drip | sprinkler | flood | rainfed | other | unknown
  soilType         String?   @default("unknown") // sandy | loamy | clay | black | red | alluvial | other | unknown
  status           String    @default("empty") // empty | planned | active | fallow
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  farm              Farm                  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropCycles        CropCycle[]
  tasks             Task[]
  soilProfile       SoilProfile?
  soilReports       SoilReport[]
  soilTests         SoilTest[]
  observations      FarmObservation[]
  irrigationRecords IrrigationRecord[]
  sensorMoistures   FarmSensorMoisture[]
  devices           IotDevice[]
  iotReadings       IotTelemetryReading[]
  diagnoses         CropDiagnosisRecord[]

  @@index([farmId])
}

// -------------------------------------------------------------
// CROP MASTER & CYCLES
// -------------------------------------------------------------

model Crop {
  id                  String            @id @default(uuid())
  slug                String            @unique
  category            String            @default("cereal") // cereal | pulse | oilseed | cash_crop | vegetable | fruit | spice | plantation | fodder | regional
  scientificName      String?
  seasons             String            @default("[]") // JSON string array e.g. ["kharif", "rabi", "zaid", "perennial"]
  typicalDurationDays Int?
  climate             String?
  soilSuitability     String?
  sowingPeriod        String?
  irrigationGuidance  String?
  nutrientGuidance    String?
  commonWeeds         String?
  commonDiseases      String?
  commonPests         String?
  harvestGuidance     String?
  storageGuidance     String?
  sourceAuthority     String?
  lastVerifiedAt      DateTime?
  displayColor        String            @default("#2F7D4F")
  icon                String?           @default("sprout")
  status              String            @default("published") // draft | published | archived
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  translations        CropTranslation[]
  varieties           CropVariety[]
  stages              CropStage[]
  cropCycles          CropCycle[]
}

model CropTranslation {
  id          String   @id @default(uuid())
  cropId      String
  locale      String   // en | hi | gu
  name        String
  aliases     String   @default("[]") // JSON string array of local aliases
  description String?

  crop        Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([cropId, locale])
}

model CropVariety {
  id           String      @id @default(uuid())
  cropId       String
  name         String
  durationDays Int?
  notes        String?
  status       String      @default("published")

  crop         Crop        @relation(fields: [cropId], references: [id], onDelete: Cascade)
  cropCycles   CropCycle[]
}

model CropStage {
  id               String                 @id @default(uuid())
  cropId           String
  orderIndex       Int
  code             String
  startOffsetDays  Int
  durationDays     Int
  whatToDo         String?
  whyImportant     String?
  howToDo          String?
  precautions      String?
  materials        String?
  isEssential      Boolean                @default(true)
  status           String                 @default("published")

  crop             Crop                   @relation(fields: [cropId], references: [id], onDelete: Cascade)
  translations     CropStageTranslation[]
  advisories       CropStageAdvisory[]
  cycleStages      CycleStage[]

  @@unique([cropId, orderIndex])
}

model CropStageTranslation {
  id          String    @id @default(uuid())
  stageId     String
  locale      String
  name        String
  description String?

  stage       CropStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, locale])
}

model CropStageAdvisory {
  id                        String                         @id @default(uuid())
  stageId                   String
  activityType              String                         // irrigation | fertilizer | spraying | scouting | custom
  requiresLocalConfirmation Boolean                        @default(true)
  status                    String                         @default("published")

  stage                     CropStage                      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  translations              CropStageAdvisoryTranslation[]
}

model CropStageAdvisoryTranslation {
  id         String            @id @default(uuid())
  advisoryId String
  locale     String
  text       String

  advisory   CropStageAdvisory @relation(fields: [advisoryId], references: [id], onDelete: Cascade)

  @@unique([advisoryId, locale])
}

model CropCycle {
  id                     String      @id @default(uuid())
  fieldId                String
  cropId                 String
  varietyId              String?
  customCropName         String?
  status                 String      @default("planned") // planned | sown | growing | flowering | fruiting | harvest_ready | harvested | completed
  sowingDate             DateTime?
  expectedHarvestDate    DateTime?
  expectedHarvestBasis   String?     @default("estimate_from_master")
  actualHarvestDate      DateTime?
  areaHa                 Float?
  irrigationType         String?
  seedInfo               String?
  quantityHarvested      Float?
  quantityUnit           String?     @default("kg")
  notes                  String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  deletedAt              DateTime?

  field                  Field       @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  crop                   Crop        @relation(fields: [cropId], references: [id], onDelete: Cascade)
  variety                CropVariety? @relation(fields: [varietyId], references: [id])
  stages                 CycleStage[]
  tasks                  Task[]
  observations           FarmObservation[]
  irrigationRecords      IrrigationRecord[]
  diagnoses              CropDiagnosisRecord[]

  @@index([fieldId, status])
}

model CycleStage {
  id              String     @id @default(uuid())
  cropCycleId     String
  templateStageId String?
  nameSnapshot    String
  startDate       DateTime?
  endDate         DateTime?
  orderIndex      Int
  status          String     @default("pending") // pending | current | done | skipped

  cropCycle       CropCycle  @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  templateStage   CropStage? @relation(fields: [templateStageId], references: [id])

  @@unique([cropCycleId, orderIndex])
}

// -------------------------------------------------------------
// TASKS & ACTIVITIES
// -------------------------------------------------------------

model Task {
  id                String    @id @default(uuid())
  userId            String
  farmId            String
  fieldId           String?
  cropCycleId       String?
  type              String    @default("custom") // irrigation | fertilizer | scouting | spraying | sowing | harvesting | machinery | labour | custom
  title             String
  description       String?
  dueAt             DateTime?
  priority          String    @default("medium") // low | medium | high
  status            String    @default("pending") // pending | in_progress | completed | skipped
  source            String    @default("manual") // manual | suggested | system
  recurrenceRule    String?
  reminderMinutes   Int?
  completedAt       DateTime?
  completedBy       String?
  completionDetails String?   // JSON string
  skippedReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm              Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  field             Field?      @relation(fields: [fieldId], references: [id])
  cropCycle         CropCycle? @relation(fields: [cropCycleId], references: [id])

  @@index([userId, status])
}

// -------------------------------------------------------------
// WEATHER & ADVISORIES
// -------------------------------------------------------------

model WeatherRecord {
  id                String   @id @default(uuid())
  farmId            String?
  latRound          Float
  lngRound          Float
  kind              String   // current | hourly | daily
  validAt           DateTime
  payloadNormalized String   // JSON string
  provider          String   @default("open-meteo")
  fetchedAt         DateTime @default(now())

  farm              Farm?    @relation(fields: [farmId], references: [id])

  @@index([fetchedAt])
}

model AdvisoryRule {
  id                 String   @id @default(uuid())
  code               String   @unique
  conditionJson      String   // JSON string of conditions
  messageKey         String
  appliesToTaskTypes String   // JSON array of types
  status             String   @default("published")
  createdAt          DateTime @default(now())
}

// -------------------------------------------------------------
// SOIL HEALTH & REPORTS
// -------------------------------------------------------------

model SoilProfile {
  id         String   @id @default(uuid())
  fieldId    String   @unique
  soilType   String   @default("unknown")
  pathChosen String   @default("unknown") // health_card | report | known_type | unknown | test_requested | sensor
  notes      String?

  field      Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model SoilReport {
  id               String     @id @default(uuid())
  fieldId          String
  fileId           String?
  reportType       String     @default("health_card") // health_card | lab_report
  status           String     @default("uploaded") // uploaded | scanning | extracted | needs_confirmation | confirmed | failed
  labName          String?
  sampledOn        DateTime?
  extractedPayload String?    // JSON string
  confirmedAt      DateTime?
  failureReason    String?
  createdAt        DateTime   @default(now())

  field            Field      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  soilTests        SoilTest[]
}

model SoilTest {
  id           String          @id @default(uuid())
  soilReportId String?
  fieldId      String
  testedOn     DateTime        @default(now())
  source       String          @default("farmer_report") // farmer_report | manual | sensor | lab
  confirmed    Boolean         @default(true)

  soilReport   SoilReport?     @relation(fields: [soilReportId], references: [id])
  field        Field           @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  parameters   SoilParameter[]
}

model SoilParameter {
  id         String   @id @default(uuid())
  soilTestId String
  code       String   // ph | ec | oc | n | p | k | s | zn | fe | cu | mn | b
  value      Float
  unit       String   // e.g. kg/ha, ppm, dS/m
  rating     String?  // low | medium | high

  soilTest   SoilTest @relation(fields: [soilTestId], references: [id], onDelete: Cascade)

  @@unique([soilTestId, code])
}

// -------------------------------------------------------------
// SCOUTING & IRRIGATION
// -------------------------------------------------------------

model FarmObservation {
  id            String     @id @default(uuid())
  userId        String
  fieldId       String
  cropCycleId   String?
  observedAt    DateTime   @default(now())
  category      String     @default("general") // pest | disease | weed | nutrient_issue | irrigation_issue | growth_issue | general
  severity      Int        @default(1) // 1 to 3
  lat           Float?
  lng           Float?
  stageSnapshot String?
  notes         String?
  photosJson    String     @default("[]") // JSON string array of file UUIDs
  source        String     @default("manual") // manual | sensor | expert
  status        String     @default("open")   // open | resolved | monitoring
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  field         Field      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  cropCycle     CropCycle? @relation(fields: [cropCycleId], references: [id])

  @@index([userId, observedAt])
  @@index([fieldId, observedAt])
}

model IrrigationRecord {
  id              String     @id @default(uuid())
  userId          String
  fieldId         String
  cropCycleId     String?
  irrigatedAt     DateTime   @default(now())
  method          String     @default("drip") // drip | sprinkler | flood | rainfed | other
  durationMinutes Int?
  volumeL         Float?     // Only stored when explicitly measured/estimated by caller
  waterSource     String?
  moistureNote    String?    // dry | moist | wet
  notes           String?
  source          String     @default("manual") // manual | sensor
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  field           Field      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  cropCycle       CropCycle? @relation(fields: [cropCycleId], references: [id])

  @@index([userId, irrigatedAt])
  @@index([fieldId, irrigatedAt])
}

model CropDiagnosisRecord {
  id                    String     @id @default(uuid())
  userId                String
  fieldId               String
  cropCycleId           String?
  imagePath             String     // Stored in private uploads directory (relative path, never public)
  originalFilename      String
  mimeType              String
  fileSizeBytes         Int
  status                String     // accepted | uncertain | not_crop | in_validation | model_not_ready
  selectedCrop          String?    // Manually selected crop by farmer (e.g. Cotton, Wheat, Rice)
  detectedCrop          String?    // Botanically identified crop by CV detector
  predictedLabel        String?
  cropName              String?
  diseaseName           String?
  isHealthy             Boolean?
  confidence            Float?     // Softmax top-1 score (0.0 to 1.0)
  severity              String?    // mild | moderate | severe | none
  topKJson              String     @default("[]") // JSON string array of candidates
  uncertaintyReason     String?
  modelId               String?    // Specific model identifier (e.g. cotton-specialist-effnet-v2)
  modelName             String     @default("agri-plant-disease-resnet50")
  modelVersion          String     @default("1.0.0")
  source                String     @default("farmer_upload") // farmer_upload | field_scouting
  notes                 String?
  feedbackRating        Int?       // Farmer rating 1-5
  feedbackNotes         String?    // Farmer comments
  feedbackAccurate      Boolean?   // Farmer verified correctness
  metadataJson          String?    // Image resolution, blur score, chlorophyll ratio
  diagnosedAt           DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  field                 Field               @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  cropCycle             CropCycle?          @relation(fields: [cropCycleId], references: [id])
  feedbacks             DiagnosisFeedback[]

  @@index([userId, diagnosedAt])
  @@index([fieldId, diagnosedAt])
  @@index([selectedCrop])
  @@index([modelId])
}

model AiModelRegistry {
  id                    String     @id @default(uuid())
  modelId               String     @unique
  name                  String
  version               String
  architecture          String
  category              String     // specialist | general_benchmark | crop_detector
  targetCropsJson       String     // JSON array of crop slugs e.g. ["cotton"]
  supportedClassesCount Int
  classesJson           String     // JSON array of supported class labels
  datasetSource         String
  license               String
  accuracy              Float?
  precision             Float?
  recall                Float?
  f1Score               Float?
  status                String     @default("active") // active | in_validation | deprecated
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([modelId])
  @@index([status])
}

model DiagnosisFeedback {
  id                    String              @id @default(uuid())
  diagnosisId           String
  userId                String
  isAccurate            Boolean
  correctedDisease      String?
  rating                Int?
  comments              String?
  createdAt             DateTime            @default(now())

  diagnosis             CropDiagnosisRecord @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([diagnosisId])
  @@index([userId])
}

// -------------------------------------------------------------
// FILES, NOTIFICATIONS & AUDIT LOGS
// -------------------------------------------------------------

model File {
  id                    String   @id @default(uuid())
  ownerUserId           String
  storageKey            String
  originalNameSanitized String
  mime                  String
  sizeBytes             Int
  sha256                String?
  purpose               String   @default("general") // soil_report | scouting_photo | receipt | custom
  attachableType        String?
  attachableId          String?
  createdAt             DateTime @default(now())

  owner                 User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    // weather | task | irrigation | disease | market | system
  titleKey  String
  bodyKey   String
  paramsJson String   @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id      String  @id @default(uuid())
  userId  String
  type    String  // weather | task | irrigation | disease | market | crop_stage | order | security | system
  channel String  @default("in_app") // in_app | email | sms | push
  enabled Boolean @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
}

model ScheduledReminder {
  id           String    @id @default(uuid())
  userId       String
  cropCycleId  String?
  taskId       String?
  fieldId      String?
  category     String    // crop_stage | task | irrigation | fertilizer | pest | weather | disease | system
  dedupeKey    String    @unique
  scheduledFor DateTime
  title        String
  body         String
  payloadJson  String    @default("{}")
  status       String    @default("pending") // pending | sent | failed | skipped
  attempts     Int       @default(0)
  lastError    String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, scheduledFor])
  @@index([status, scheduledFor])
}

model EmailDeliveryLog {
  id                String    @id @default(uuid())
  userId            String?
  toEmail           String
  templateKey       String    // verification | password_reset | security_login | crop_stage | task_reminder | weather_alert | disease_alert | order_confirmation | order_status
  subject           String
  locale            String    @default("en")
  dedupeKey         String?
  status            String    @default("queued") // queued | sent | simulated | failed | retrying
  provider          String    @default("local_outbox")
  providerMessageId String?
  attempts          Int       @default(1)
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([dedupeKey])
  @@index([status, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  oldValues    String?  // JSON string
  newValues    String?  // JSON string
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

// -------------------------------------------------------------
// LIVE MANDI & MARKET INTELLIGENCE
// -------------------------------------------------------------

model MarketCommodity {
  id           String   @id @default(uuid())
  name         String   // e.g. Wheat, Cotton, Groundnut, Cumin, Mustard, Soybean, Onion, Potato, Tomato, Gram
  variety      String?  // e.g. Lokwan, Shankar-6, Desi, Hybrid
  cropSlug     String?  // matches Crop.slug if mapped
  category     String?  // Cereal, Fiber, Oilseed, Spice, Vegetable, Pulse
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  observations MarketPriceObservation[]

  @@unique([name, variety])
}

model MarketLocation {
  id        String   @id @default(uuid())
  name      String   // Mandi / APMC Name e.g. Rajkot, Gondal, Unjha, Surat, Amreli, Mahuva, Dahod
  state     String   // e.g. Gujarat, Maharashtra, Punjab, Madhya Pradesh, Rajasthan
  district  String   // e.g. Rajkot, Mehsana, Surat, Amreli, Bhavnagar
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  observations MarketPriceObservation[]

  @@unique([name, state, district])
  @@index([state, district])
}

model MarketPriceObservation {
  id               String   @id @default(uuid())
  locationId       String
  commodityId      String
  grade            String   @default("") // AGMARKNET grade (FAQ, Non-FAQ, etc.)
  minPrice         Float?   // Nullable — never convert missing upstream values to zero
  maxPrice         Float?   // Nullable — never convert missing upstream values to zero
  modalPrice       Float?   // Nullable — never convert missing upstream values to zero
  unit             String   @default("₹/Quintal") // Normalized Agmarknet unit
  priceDate        DateTime // Agmarknet reported trading/arrival date
  source           String   @default("AGMARKNET / data.gov.in")
  sourceResourceId String?  // data.gov.in resource ID for provenance
  fetchedAt        DateTime @default(now())
  syncRunId        String?  // Links to MarketSyncLog.id for sync provenance
  isDemo           Boolean  @default(false)
  qualityStatus    String   @default("ok") // ok | anomaly_price_order | missing_price
  notes            String?

  location    MarketLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  commodity   MarketCommodity @relation(fields: [commodityId], references: [id], onDelete: Cascade)

  @@unique([locationId, commodityId, priceDate, source, grade])
  @@index([commodityId, priceDate])
  @@index([locationId, priceDate])
}

model MarketSyncLog {
  id                    String    @id @default(uuid())
  provider              String    // agmarknet | demo
  triggerSource         String    @default("scheduled") // scheduled | manual | cli
  status                String    // success | failed | partial | running
  recordsFetched        Int       @default(0)
  recordsStored         Int       @default(0)
  recordsSkipped        Int       @default(0)
  sourcePublicationDate DateTime?
  errorMessage          String?
  durationMs            Int?
  startedAt             DateTime  @default(now())
  completedAt           DateTime?

  @@index([startedAt])
}

model MarketSyncLock {
  id        String   @id @default("market_sync")
  lockedAt  DateTime @default(now())
  lockedBy  String   // run ID or worker ID
  expiresAt DateTime // timestamp after which the lock is considered stale
}

// -------------------------------------------------------------
// FERTILIZER KNOWLEDGE CENTER
// -------------------------------------------------------------

model FertilizerCategory {
  id              String   @id @default(uuid())
  name            String   // Urea, DAP, SSP, MOP / Potash, NPK 10:26:26, Water-Soluble 19:19:19, Organic Vermicompost, Biofertilizer, Zinc Sulphate
  slug            String   @unique
  nutrientProfile String   // e.g. "46% Nitrogen (N)", "18% N, 46% P2O5", "60% K2O"
  description     String
  applicationRole String   // Primary vegetative, Root initiation, Stress resistance, etc.
  precautions     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guidances       CropFertilizerGuidance[]
}

model CropFertilizerGuidance {
  id                   String              @id @default(uuid())
  cropSlug             String              // wheat, cotton, groundnut, rice, etc.
  cropName             String              // Wheat, Cotton, etc.
  state                String              @default("Gujarat & Western India")
  cropStage            String              // Basal / Land Prep, Tillering, Flowering, Boll formation
  nutrientRequirement  String              // Nitrogen (N), Phosphorus (P2O5), Potassium (K2O), Zinc (Zn)
  fertilizerCategoryId String?
  recommendedTiming    String              // e.g. "At sowing time / Land preparation", "20-25 days after sowing"
  applicationMethod    String              // Deep placement, Band placement, Broadcasting before irrigation, Foliar spray
  guidanceText         String              // Detailed agronomic instruction
  whyItMatters         String              // Nutrient physiology reason
  importantPrecautions String              // Soil testing reminder, salinity warning, avoid excessive N
  sourceAuthority      String              // ICAR / Anand Agricultural University (AAU) / Junagadh Agricultural University (JAU)
  sourceUrl            String?
  lastVerifiedDate     DateTime            @default(now())
  status               String              @default("verified") // verified | advisory

  fertilizerCategory   FertilizerCategory? @relation(fields: [fertilizerCategoryId], references: [id])

  @@index([cropSlug, cropStage])
}

// -------------------------------------------------------------
// FERTILIZER E-COMMERCE STORE
// -------------------------------------------------------------

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    // Chemical Fertilizers, Water-Soluble Fertilizers, Organic & Bio-Fertilizers, Micronutrients
  slug        String    @unique
  description String?
  icon        String?   @default("package")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model ProductBrand {
  id        String    @id @default(uuid())
  name      String    @unique // IFFCO, GSFC, GNFC, KRIBHCO, Tata Paras, Coromandel
  origin    String    @default("India")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]
}

model Product {
  id                String          @id @default(uuid())
  name              String
  slug              String          @unique
  brandId           String
  categoryId        String
  cropTarget        String?         // wheat,cotton,groundnut,all
  description       String
  composition       String?         // e.g. "46% N", "18-46-0", "19-19-19"
  packSize          String          // "45 kg Bag", "50 kg Bag", "1 kg Pack", "5 kg Bucket"
  price             Float           // Selling Price in INR
  mrp               Float?          // Maximum Retail Price
  stock             Int             @default(50)
  imageUrl          String
  isAvailable       Boolean         @default(true)
  usageInstructions String?
  safetyNotes       String?
  sellerName        String          @default("SmartFarm Certified Agri-Input Cooperative")
  sellerLicense     String?         @default("GJ-AGRI-COOP-2026-88")
  isDemoProduct     Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  brand             ProductBrand    @relation(fields: [brandId], references: [id])
  category          ProductCategory @relation(fields: [categoryId], references: [id])
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([categoryId])
  @@index([brandId])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  userId           String
  status           String      @default("confirmed") // pending | confirmed | processing | shipped | delivered | cancelled
  subtotal         Float
  deliveryFee      Float       @default(0)
  discount         Float       @default(0)
  totalAmount      Float
  paymentMethod    String      @default("demo_checkout") // demo_checkout | cod | online_upi
  paymentStatus    String      @default("test_paid") // pending | test_paid | awaiting_payment
  isDemoOrder      Boolean     @default(true)
  deliveryName     String
  deliveryPhone    String
  deliveryAddress  String
  deliveryVillage  String?
  deliveryDistrict String
  deliveryState    String      @default("Gujarat")
  deliveryPincode  String
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            OrderItem[]

  @@index([userId, status])
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  productId           String
  productNameSnapshot String
  unitPriceSnapshot   Float
  packSizeSnapshot    String
  quantity            Int
  totalPrice          Float

  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id])
}

// -------------------------------------------------------------
// SOIL MOISTURE INTELLIGENCE (GOVERNMENT NRSC VIC & SENSORS)
// -------------------------------------------------------------

model SoilMoistureObservation {
  id                   String   @id @default(uuid())
  state                String   // e.g. Gujarat
  district             String   // e.g. Vadodara, Rajkot, Ahmedabad, Anand, Surat
  observationDate      DateTime // Model observation date
  moistureValue        Float    // Volumetric soil moisture (e.g. 0.28 m3/m3)
  originalUnit         String   @default("m3/m3")
  normalizedPercentage Float    // Converted to percentage (0-100%)
  depthRangeCm         String   @default("0-50 cm")
  spatialResolution    String   @default("district_level_vic_model")
  modelProvider        String   @default("NRSC / ISRO Hydrological VIC Model")
  datasetCatalog       String   @default("Open Government Data (data.gov.in / daily-data-soil-moisture)")
  resourceId           String?
  sourceUrl            String   @default("https://data.gov.in/catalog/daily-data-soil-moisture")
  fetchedAt            DateTime @default(now())
  qualityStatus        String   @default("verified_model_estimate")
  isDemo               Boolean  @default(false)
  notes                String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([state, district, observationDate, spatialResolution])
  @@index([state, district, observationDate])
  @@index([observationDate])
}

model FarmSensorMoisture {
  id           String    @id @default(uuid())
  fieldId      String
  sensorId     String?   // e.g. SN-SOIL-GJ-041
  hardwareType String?   // e.g. Capacitive FDR / TDR Sensor
  readingAt    DateTime  @default(now())
  depthCm      Int       @default(15)
  moisturePct  Float     // Measured %
  temperatureC Float?
  batteryPct   Float?
  status       String    @default("active") // active | disconnected | low_battery

  field        Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, readingAt])
}

// -------------------------------------------------------------
// IOT DEVICE REGISTRY & SENSOR TELEMETRY PIPELINE (PHASE 5)
// -------------------------------------------------------------

model IotDevice {
  id              String                @id @default(uuid())
  deviceCode      String                @unique // e.g. "SF-IOT-ESP32-001" or MAC-based identifier
  name            String                // Human label e.g. "North Field Moisture Probe #1"
  hardwareModel   String?               @default("ESP32-SoilV1")
  farmId          String
  fieldId         String
  tokenHash       String                // One-way SHA-256 hash of device secret bearer token
  status          String                @default("active") // active | revoked | provisioning
  isDemo          Boolean               @default(false)
  lastSeenAt      DateTime?
  lastIp          String?
  firmwareVersion String?
  batteryVoltage  Float?
  calibrationJson String?               @default("{}") // e.g. {"rawDry": 3200, "rawWet": 1400, "version": 1}
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  farm            Farm                  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  field           Field                 @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  readings        IotTelemetryReading[]
  events          IotDeviceEvent[]

  @@index([farmId])
  @@index([fieldId])
  @@index([status])
}

model IotTelemetryReading {
  id               String    @id @default(uuid())
  deviceId         String
  fieldId          String    // Denormalized for rapid field-scoped time-series queries
  eventId          String?   // Client-generated deduplication UUID/nonce
  measuredAt       DateTime  // Device clock time
  receivedAt       DateTime  @default(now()) // Server clock time
  soilMoistureRaw  Int?      // Raw ADC reading (e.g. 0-4095 for ESP32 12-bit ADC)
  soilMoisturePct  Float?    // Relative calibrated moisture index (0-100%, NOT lab VWC)
  depthCm          Int?      @default(15) // Sensor installation depth
  airTempC         Float?    // Ambient temperature in Celsius (-40 to 85)
  airHumidityPct   Float?    // Ambient relative humidity (0-100%)
  lightLux         Float?    // Ambient light intensity (0-120000 lux)
  batteryVoltage   Float?    // Battery voltage (e.g. 3.2V to 4.2V)
  batteryPct       Float?    // Battery percentage (0-100%)
  waterLevelSwitch Boolean?  // Digital flood/water-level contact switch
  qualityStatus    String    @default("clean") // clean | suspicious_skew | out_of_range | uncalibrated
  qualityFlags     String?   @default("[]") // JSON string array of quality warnings
  isDemo           Boolean   @default(false)

  device           IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  field            Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([deviceId, eventId])
  @@index([deviceId, measuredAt])
  @@index([fieldId, measuredAt])
  @@index([receivedAt])
}

model IotDeviceEvent {
  id          String    @id @default(uuid())
  deviceId    String
  eventType   String    // boot | token_rotated | status_change | clock_skew_warning | calibration_updated
  severity    String    @default("info") // info | warning | error
  detailsJson String?   @default("{}")
  createdAt   DateTime  @default(now())

  device      IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
}

// -------------------------------------------------------------
// KNOWLEDGE BASE & GROUNDED RAG ASSISTANT
// -------------------------------------------------------------

model KnowledgeDocument {
  id              String           @id @default(uuid())
  slug            String           @unique
  title           String
  issuingOrg      String           // e.g. ICAR, AAU, JAU, KVK
  sourceUrl       String?
  publicationDate DateTime?
  crop            String?          // cotton, wheat, groundnut, tomato, etc.
  topic           String           // pest_management, irrigation, fertilizer, soil_health
  region          String?          // e.g. Gujarat, Western India, Pan-India
  language        String           @default("en") // en, hi, gu
  license         String           // Government Open Data License - India (GODL)
  checksum        String           // SHA-256 of source content
  lastVerifiedAt  DateTime?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  chunks          KnowledgeChunk[]

  @@index([crop, topic])
  @@index([language])
}

model KnowledgeChunk {
  id          String            @id @default(uuid())
  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex  Int
  title       String
  content     String
  keywords    String            // Search keywords space-separated
  tokenCount  Int
  crop        String?
  topic       String?
  language    String            @default("en")
  checksum    String
  createdAt   DateTime          @default(now())

  @@index([documentId])
  @@index([crop, topic])
  @@index([language])
}

model AssistantConversation {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  messages  AssistantMessage[]

  @@index([userId, createdAt])
}

model AssistantMessage {
  id             String                @id @default(uuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String                // 'user' | 'assistant' | 'system'
  content        String
  structuredJson String?               // Serialized JSON of structured response envelope
  providerId     String?               // 'openai' | 'gemini' | 'anthropic' | 'mock'
  model          String?
  confidence     String?               // 'high' | 'medium' | 'low'
  isHelpful      Boolean?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}



