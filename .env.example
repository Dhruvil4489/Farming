# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Connection
# For Local PostgreSQL 18 (Target Database: Farmer):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/Farmer?schema=public"
# For Local SQLite (Fallback/Development):
DATABASE_URL="postgresql://postgres:8834@localhost:5432/Farmer?schema=public"
# DATABASE_URL="file:./dev.db"

# Authentication & JWT Secrets
JWT_SECRET="your-jwt-secret-min-32-chars"
SESSION_SECRET="your-session-secret-min-32-chars"

# Weather Provider Integration
# Options: "open-meteo" (no API key required), "demo"
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""

# Live Mandi Market Provider Integration (AGMARKNET / data.gov.in)
# Options: "agmarknet", "demo"
# To obtain an official data.gov.in API key:
# 1. Register at https://data.gov.in/
# 2. Navigate to "My Account" -> "API Key Management"
# 3. Generate your API key and paste it below
# 4. Set MARKET_PROVIDER="agmarknet"
MARKET_PROVIDER="demo"
MARKET_API_KEY=""
DATA_GOV_IN_API_KEY=""

# AI Decision Support Provider
# Options: "openai", "anthropic", "gemini", "mock"
AI_PROVIDER="mock"
AI_API_KEY=""

# File Storage
STORAGE_DISK="local"
