# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Connection
# For Local PostgreSQL 18 (Target Database: Farmer):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/Farmer?schema=public"
# For Local SQLite (Fallback/Development):
DATABASE_URL="postgresql://postgres:8834@localhost:5432/Farmer?schema=public"
# DATABASE_URL="file:./dev.db"

# Authentication & JWT Secrets
JWT_SECRET="your-jwt-secret-min-32-chars"
SESSION_SECRET="your-session-secret-min-32-chars"

# Weather Provider Integration
# Options: "open-meteo" (no API key required), "demo"
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""

# Live Mandi Market Provider Integration (AGMARKNET / data.gov.in)
# Options: "agmarknet", "demo"
# Primary Catalog: Current Daily Price of Various Commodities from Various Markets (Mandi)
# Official Resource ID: 9ef84268-d588-465a-a308-a864a43d0070
# Alternate Resource: Variety-wise Daily Market Prices (35985678-0d79-46b4-9ed6-6f13308a5d24)
# To obtain an official data.gov.in API key:
# 1. Register at https://data.gov.in/
# 2. Navigate to "My Account" -> "API Key Management"
# 3. Generate your API key and assign below
# 4. When MARKET_PROVIDER="agmarknet", live calls query data.gov.in; if unreachable, falls back to verified DB records
MARKET_PROVIDER="agmarknet"
MARKET_API_KEY=""
DATA_GOV_IN_API_KEY=""

# Official Soil Moisture Provider Integration (NRSC / ISRO VIC Hydrological Model)
# Options: "government", "demo"
# Primary Catalog: https://data.gov.in/catalog/daily-data-soil-moisture
# Secondary Catalog: https://ap.data.gov.in/catalog/soil-moisture
# Spatial Resolution: District-level hydrological VIC macroscale model (0–50 cm depth)
# Units: Volumetric water content (m³/m³) normalized to 0-100% plant-available moisture
# When SOIL_MOISTURE_PROVIDER="government", live calls query data.gov.in; if unconfigured/unreachable,
# the service automatically serves verified NRSC VIC observations stored in PostgreSQL.
SOIL_MOISTURE_PROVIDER="government"
SOIL_MOISTURE_API_KEY=""
SOIL_MOISTURE_API_ENDPOINT="https://api.data.gov.in/resource/daily-soil-moisture"

# AI Decision Support Provider
# Options: "openai", "anthropic", "gemini", "mock"
AI_PROVIDER="mock"
AI_API_KEY=""

# File Storage
STORAGE_DISK="local"
