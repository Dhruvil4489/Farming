# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# ─── Database Connection ──────────────────────────────────────────────────────
# SQLite — fast local development, no extra service required (recommended to start):
DATABASE_URL="file:./dev.db"

# PostgreSQL — production target (swap schema using `npm run db:switch:postgres` first):
# DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/Farmer?schema=public"

# ─── Authentication & Session ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters. SERVER-ONLY — never prefix with NEXT_PUBLIC_.
JWT_SECRET="replace-with-at-least-32-random-chars"

# ─── Weather Provider ─────────────────────────────────────────────────────────
# Options: "open-meteo" (no API key required, free tier) | "demo" (synthetic fallback)
# Open-Meteo is the recommended default — no key needed.
WEATHER_PROVIDER="open-meteo"

# ─── Mandi Market Data Provider (AGMARKNET / data.gov.in) ────────────────────
# Options: "agmarknet" (live government feed) | "demo" (seeded reference data)
#
# To use the live feed:
#   1. Register at https://data.gov.in/
#   2. Go to My Account → API Key Management → generate a key
#   3. Set MARKET_PROVIDER="agmarknet" and paste your key below
#   4. Resource ID used: 9ef84268-d588-465a-a308-a864a43d0070
#      (Current Daily Price of Various Commodities from Various Markets)
#
# Without a key the app serves the seeded reference dataset. SERVER-ONLY.
MARKET_PROVIDER="demo"
MARKET_API_KEY=""
DATA_GOV_IN_API_KEY=""

# ─── Soil Moisture Provider (NRSC / ISRO VIC Hydrological Model) ─────────────
# Options: "government" (data.gov.in VIC model) | "demo" (seeded archive)
#
# Without a DATA_GOV_IN_API_KEY the service automatically falls back to the
# verified NRSC VIC observation archive seeded into the database.
#
# Note: The live endpoint below is the catalog page. The exact resource ID for
# the daily-soil-moisture dataset must be confirmed at https://data.gov.in/
# before enabling the live provider.
SOIL_MOISTURE_PROVIDER="government"
SOIL_MOISTURE_API_KEY=""
SOIL_MOISTURE_API_ENDPOINT="https://api.data.gov.in/resource/daily-soil-moisture"

# ─── AI Decision Support Provider ────────────────────────────────────────────
# Options: "openai" | "anthropic" | "gemini" | "mock"
#
# IMPORTANT: The AI assistant backend route (/api/v1/assistant) is not yet
# implemented (Phase 4 work). Setting a provider here has no effect until
# Options: "gemini" | "openai" | "anthropic" | "mock"
# In production, "mock" is rejected unless ALLOW_MOCK_AI="true".
#
# SERVER-ONLY — never prefix with NEXT_PUBLIC_.
AI_PROVIDER="mock"
ALLOW_MOCK_AI="true"

# Google Gemini (Recommended for multilingual support: English, Hindi, Gujarati)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_API_BASE="https://api.openai.com/v1"

# Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ─── File Storage ─────────────────────────────────────────────────────────────
# Options: "local" (writes to /storage/uploads relative to project root)
# S3 adapter is planned but not yet implemented.
STORAGE_DISK="local"

# ─── Scheduled Job / Cron Secret ──────────────────────────────────────────────
# Secret token used by external schedulers (crontab, systemd, GitHub Actions,
# Vercel Cron, GCP Cloud Scheduler, AWS EventBridge) to trigger scheduled runs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SERVER-ONLY — never prefix with NEXT_PUBLIC_. Keep cadence conservative (twice daily).
CRON_SECRET=""
MARKET_SYNC_CRON_SCHEDULE="0 1,13 * * *" # UTC times (06:30 and 18:30 IST)
MARKET_SYNC_CRON_TIMEZONE="Asia/Kolkata"

# -------------------------------------------------------------
# IOT TELEMETRY & HARDWARE SENSORS (PHASE 5)
# -------------------------------------------------------------
# Set to 'true' to allow running the deterministic sensor simulator in development/staging.
# Disabled by default in production.
IOT_SIMULATOR_ENABLED="false"


